# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Database name created by db/tools/setup.sh
DB_NAME=academiaos

# Password setup.sh gives the academiaos_app login role
APP_DB_PASSWORD=change_me

# Flask ALWAYS connects with this (low-privilege role, row-level security applies)
DATABASE_URL=postgresql://academiaos_app:change_me@localhost:5432/academiaos

# Superuser / owner connection. Used ONLY by db/tools/setup.sh and
# flask_backend/scripts/generate_embeddings_sql.py, which bypass RLS on purpose.
# Flask never reads it.
ADMIN_DATABASE_URL=postgresql://postgres:change_me@localhost:5432/academiaos

# Signs login tokens (JWT). Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_string

FLASK_PORT=5000
CORS_ORIGINS=http://localhost:3000

# Embedding model (384 dimensions; must match VECTOR(384) in the schema)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# true = load the model when Flask starts instead of on the first search
EMBEDDING_PRELOAD=false

# Read by the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
